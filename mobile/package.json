{
  "name": "yume-mobile",
  "version": "0.1.0-alpha",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.24",
    "expo-audio": "~56.0.13",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-speech": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.4",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.6",
    "playwright": "^1.65.1",
    "react-test-renderer": "^19.2.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:journey": "expo export --platform web && node e2e/first-word.mjs",
    "export:server": "expo export --platform web --output-dir ../server/internal/webapp/dist && node -e \"require('fs').writeFileSync('../server/internal/webapp/dist/.gitkeep', '')\"",
    "check": "npm run typecheck && npm test -- --runInBand"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 60000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|wanakana)"
    ]
  }
}
